{
  "schemaVersion": 1,
  "id": "yuimorph",
  "version": "${version}",
  "name": "YuiMorph",
  "description": "YuiMorph 客户端增强：自身伪装渲染、伪装选择界面、快捷键与状态 HUD。",
  "authors": ["yui"],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/Cherry7593/YuiMorph",
    "sources": "https://github.com/Cherry7593/YuiMorph",
    "issues": "https://github.com/Cherry7593/YuiMorph/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "moe.yui.morph.client.YuiMorphClient"
      }
    ]
  },
  "mixins": [
    {
      "config": "yuimorph.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
